# ══════════════════════════════════════════════
# CompanionAI — Environment Variables
# Copy this file to .env and fill in values
# ══════════════════════════════════════════════

# ─────────────────────────────
# SERVER
# ─────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────
# DATABASE
# ─────────────────────────────
MONGODB_URI=mongodb://localhost:27017/companionai

# ─────────────────────────────
# REDIS (optional — graceful fallback if absent)
# ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────
# SECURITY
# ─────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────
# FRONTEND URL (for CORS)
# ─────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────
# AI PROVIDER
# Options: openai | groq | together | openrouter
# ─────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o

# Custom base URL (leave empty for default per provider)
AI_BASE_URL=

# ─────────────────────────────
# AI DEFAULTS
# ─────────────────────────────
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=300

# ─────────────────────────────
# WHATSAPP
# ─────────────────────────────
WA_SESSIONS_PATH=./sessions
WA_RECONNECT_DELAY=5000

# ─────────────────────────────
# LOGGING
# ─────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────
# WORKER (for background keep-alive process)
# ─────────────────────────────
WORKER_MODE=false
BACKEND_URL=http://localhost:5000

# ─────────────────────────────
# FRONTEND VARS (Next.js — prefix with NEXT_PUBLIC_)
# ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
