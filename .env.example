# ══════════════════════════════════════════════
# CompanionAI — Environment Variables
# Copy this file to .env and fill in values
# ══════════════════════════════════════════════

# ─────────────────────────────
# SERVER / DOCKER COMPOSE URLS
# ─────────────────────────────
# CHANGE THESE TO YOUR SERVER'S PUBLIC IP OR DOMAIN!
# Example: http://123.45.67.89:3000
FRONTEND_URL=http://localhost:3000

# Example: http://123.45.67.89:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─────────────────────────────
# DATABASE
# ─────────────────────────────
# For docker-compose, keep this as mongodb://mongo:27017/companionai
MONGODB_URI=mongodb://mongo:27017/companionai

# ─────────────────────────────
# REDIS
# ─────────────────────────────
# For docker-compose, keep this as redis://redis:6379
REDIS_URL=redis://redis:6379

# ─────────────────────────────
# SECURITY
# ─────────────────────────────
# CHANGE THIS IN PRODUCTION!
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────
# AI PROVIDER
# Options: openai | groq | together | openrouter
# ─────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o

# Custom base URL (leave empty for default per provider)
AI_BASE_URL=

# ─────────────────────────────
# AI DEFAULTS
# ─────────────────────────────
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=300

# ─────────────────────────────
# WHATSAPP
# ─────────────────────────────
WA_SESSIONS_PATH=/app/sessions
WA_RECONNECT_DELAY=5000

# ─────────────────────────────
# LOGGING
# ─────────────────────────────
LOG_LEVEL=info
