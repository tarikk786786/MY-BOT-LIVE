# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp-ai

# Redis (optional - falls back to direct processing if unavailable)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another-very-long-random-secret-for-refresh-tokens

# AI Provider: openai | groq | together | openrouter
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o

# WhatsApp
WA_SESSION_PATH=./sessions

# Logging
LOG_LEVEL=info
